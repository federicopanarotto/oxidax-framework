# Production environment variable template.
# Copy this file to `.env` (same folder, do NOT commit it) and adapt the values.

# Database backend: `surreal` with the compose instance, or `memory` (demo only).
DB_BACKEND=surreal

# Address the API process binds to (inside the container).
SERVER_ADDR=0.0.0.0:3000

# SurrealDB is reachable through the compose service name (`surreal`).
SURREAL_URL=ws://surreal:8000
SURREAL_NS=oxidax
SURREAL_DB=production

# SurrealDB credentials used both by the server (compose command) and by the API.
# Generate a strong password, e.g. with `openssl rand -base64 32`.
SURREAL_USER=root
SURREAL_PASS=change-me-strong-database-password

# Secret the API signs JWTs with: any long random string.
# Generate: `openssl rand -base64 48`.
JWT_SECRET=change-me-with-a-very-long-random-string
# Token lifetime, in seconds (15 minutes / 7 days).
ACCESS_TOKEN_DURATION=900
REFRESH_TOKEN_DURATION=604800

# ---- docker-compose only ----
# Public host port the API is exposed on.
API_PUBLIC_PORT=3000
