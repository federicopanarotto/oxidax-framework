# Template for the Axum API runtime configuration.
# Copy this file to `.env` and adjust the values.

# Database backend: `surreal` or `memory`.
DB_BACKEND=surreal

# Address the HTTP server binds to.
SERVER_ADDR=0.0.0.0:3000

# SurrealDB connection (unused when DB_BACKEND=memory).
SURREAL_URL=ws://localhost:8000
SURREAL_NS=test
SURREAL_DB=reports
SURREAL_USER=root
SURREAL_PASS=root