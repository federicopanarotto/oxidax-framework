# Template for the Oxidax API runtime configuration.
# Copy this file to `.env` and adjust the values.

# Database backend: `surreal` or `memory`.
DB_BACKEND=surreal

# Address the HTTP server binds to.
SERVER_ADDR=0.0.0.0:3000

# SurrealDB connection (unused when DB_BACKEND=memory).
SURREAL_URL=ws://localhost:8000
SURREAL_NS=test
SURREAL_DB=reports
SURREAL_USER=root
SURREAL_PASS=root
# JWT settings.
# Secret used to sign the tokens (any long random string).
JWT_SECRET=change-me-with-a-long-random-string
# Lifetime of an access token, in seconds (15 minutes).
ACCESS_TOKEN_DURATION=900
# Lifetime of a refresh token, in seconds (7 days).
REFRESH_TOKEN_DURATION=604800

# CORS: comma-separated regex allow-list matched against the `Origin` header
# (scheme + host + port). A lone `*` allows any origin. Leave it empty or
# unset to disable CORS entirely.
# Example that allows localhost on any port and any subdomain of example.com:
#   CORS_ALLOWED_ORIGINS=^http://localhost(:\d+)?$,^https://(.+\.)?example\.com$
CORS_ALLOWED_ORIGINS=^http://localhost(:\d+)?$

